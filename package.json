{
	"name": "@tobper/eon",
	"version": "1.0.3",
	"description": "Date library",
	"repository": "github:tobper/eon",
	"license": "ISC",
	"keywords": [
		"typescript",
		"calendar",
		"date"
	],
	"author": "Tobias Persson",
	"type": "module",
	"files": [
		"lib",
		"src",
		"!**/*.tsbuildinfo"
	],
	"packageManager": "pnpm@11.5.2",
	"exports": {
		".": {
			"import": "./lib/index.js",
			"types": "./lib/types/index.d.ts"
		}
	},
	"publishConfig": {
		"@tobper:registry": "https://npm.pkg.github.com"
	},
	"scripts": {
		"build": "tsc",
		"watch": "tsc --watch",
		"spelling": "cspell -c .vscode/cSpell.json --no-progress **",
		"test": "vitest",
		"lint": "eslint .",
		"lint:fix": "pnpm -r run lint:fix"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/eslint": "^9.6.1",
		"cspell": "^10.0.0",
		"eslint": "^10.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.0",
		"vite": "^8.0.14",
		"vitest": "^4.1.7"
	}
}
